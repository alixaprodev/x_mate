{
  "manifest_version": 3,
  "name": "X Mate — Ad Blocker for X",
  "version": "1.0.0",
  "description": "Blocks promoted tweets in the timeline and sidebar ad banners on x.com / twitter.com.",
  "homepage_url": "https://github.com/alixaprodev/x_mate",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
